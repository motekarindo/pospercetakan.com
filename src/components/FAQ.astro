---
const faqs = [
  {
    question: 'Apakah POS Percetakan cocok untuk semua jenis percetakan?',
    answer: 'POS Percetakan cocok untuk berbagai jenis usaha percetakan. Seperti Percetakan digital, Outdoor, Indoor, Merchandise dan sebagainya.'
  },
  {
    question: 'Berapa lama implementasi POS Percetakan?',
    answer: 'implementasi awal membutuhkan 1 kerja untuk aplikasi bisa digunakan oleh pengguna.'
  },
  {
    question: 'Apakah bisa dipakai untuk lebih dari satu outlet?',
    answer: 'Bisa. Anda dapat mengelola beberapa outlet dalam satu akun dengan laporan terpisah maupun gabungan.'
  },
  {
    question: 'Apakah sistem mendukung pembayaran DP dan pelunasan?',
    answer: 'Ya. POS Percetakan mendukung skema pembayaran bertahap, termasuk DP, pelunasan, dan catatan jatuh tempo.'
  },
  {
    question: 'Bisakah saya menyesuaikan daftar produk dan harga?',
    answer: 'Tentu. Anda bisa membuat kategori produk, variasi bahan, ukuran, finishing, serta aturan harga sesuai kebutuhan.'
  },
  {
    question: 'Bagaimana keamanan data bisnis saya?',
    answer: 'Data disimpan dengan praktik keamanan standar industri, termasuk kontrol akses pengguna dan backup berkala.'
  },
  {
    question: 'Apakah tersedia bantuan onboarding?',
    answer: 'Ya. Tim kami membantu onboarding awal, konfigurasi dasar, dan pelatihan singkat agar tim Anda cepat produktif.'
  }
];
---

<section class="py-20 bg-payflo-gray relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>

  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold">
        Pertanyaan yang Sering Diajukan
      </h2>
      <p class="mt-4 text-xl text-gray-600">
        Hal-hal penting yang biasanya ditanyakan sebelum mulai menggunakan POS Percetakan.
      </p>
    </div>

    <div class="mt-12 max-w-3xl mx-auto">
      {faqs.map((faq, index) => (
        <div
          class="faq-item group relative mb-4 overflow-hidden rounded-lg border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:shadow-md animate-on-scroll"
          style={`animation-delay: ${index * 0.1}s`}
          data-state="closed"
        >
          <button
            type="button"
            class="faq-trigger flex w-full cursor-pointer items-center justify-between px-5 py-4 text-left transition-all duration-300 hover:bg-gray-50/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-payflo-purple data-[state=open]:text-payflo-purple md:px-6 md:py-5"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
            data-state="closed"
          >
            <span class="text-base font-medium leading-7 transition-colors duration-300 group-hover:text-payflo-purple md:text-lg">{faq.question}</span>
            <div class="ml-2 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="faq-icon h-5 w-5 text-gray-500 transition-transform duration-300 data-[state=open]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" data-state="closed">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>
          <div
            id={`faq-answer-${index}`}
            class="faq-content grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=open]:opacity-100"
            role="region"
            aria-labelledby={`faq-question-${index}`}
            aria-hidden="true"
            data-state="closed"
          >
            <div class="min-h-0 overflow-hidden px-5 pb-0 text-gray-600 transition-[padding] duration-300 data-[state=open]:pb-5 md:px-6 md:data-[state=open]:pb-6" data-state="closed">
              <p>{faq.answer}</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-payflo-purple transition-transform duration-300 group-data-[state=open]:scale-x-100"></div>
        </div>
      ))}
    </div>

    <!-- <div class="mt-12 text-center animate-on-scroll">
      <p class="text-gray-600">
        Masih ada pertanyaan? Tim kami siap membantu.
      </p>
      <a href="/contact" class="mt-4 inline-flex items-center text-payflo-purple font-medium hover:underline group">
        Hubungi Kami
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div> -->
  </div>
</section>

<script>
  const setupFaqAccordion = () => {
    document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');
      const content = item.querySelector<HTMLElement>('.faq-content');
      const contentInner = content?.querySelector<HTMLElement>('[data-state]');
      const icon = item.querySelector<SVGElement>('.faq-icon');

      if (!trigger || !content || trigger.dataset.faqBound === 'true') return;

      trigger.dataset.faqBound = 'true';

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        const nextState = isOpen ? 'closed' : 'open';

        trigger.setAttribute('aria-expanded', String(!isOpen));
        content.setAttribute('aria-hidden', String(isOpen));
        item.dataset.state = nextState;
        trigger.dataset.state = nextState;
        content.dataset.state = nextState;
        if (contentInner) contentInner.dataset.state = nextState;
        if (icon) icon.dataset.state = nextState;
      });
    });
  };

  document.addEventListener('astro:page-load', setupFaqAccordion);
  setupFaqAccordion();
</script>
