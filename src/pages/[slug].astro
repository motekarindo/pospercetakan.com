---
import Layout from '../layouts/Layout.astro';
import { localPages } from '../data/localPages';

export function getStaticPaths() {
  const getPosSlug = (slug: string) => slug.replace(/^aplikasi-percetakan-di-/, 'pos-percetakan-di-');

  return localPages.flatMap((page) => [
    {
      params: { slug: page.slug },
      props: { page, variant: 'aplikasi' },
    },
    {
      params: { slug: getPosSlug(page.slug) },
      props: { page, variant: 'pos' },
    },
  ]);
}

const { page, variant } = Astro.props;
const currentSlug = Astro.params.slug ?? page.slug;
const pageUrl = `https://pospercetakan.com/${currentSlug}/`;
const targetLocation = `${page.type} ${page.city}`;
const schemaAreaType = page.type === "Kota" ? "City" : "AdministrativeArea";
const isPosVariant = variant === 'pos';
const pageTitle = isPosVariant
  ? `POS Percetakan di ${targetLocation} | Software Kasir Percetakan`
  : page.title;
const pageDescription = isPosVariant
  ? `POS Percetakan untuk bisnis percetakan di ${targetLocation}. Kelola order, produksi, stok bahan, pembayaran, invoice, dan laporan penjualan dalam satu sistem.`
  : page.description;
const pageKeywords = isPosVariant
  ? [
      `POS percetakan di ${page.city}`,
      `POS percetakan ${targetLocation}`,
      `software POS percetakan ${page.city}`,
      `aplikasi POS percetakan ${page.city}`,
      `kasir percetakan ${page.city}`,
      `sistem POS percetakan ${page.city}`,
    ].join(', ')
  : page.keywords;
const heading = isPosVariant ? `POS Percetakan di ${targetLocation}` : `Aplikasi Percetakan di ${targetLocation}`;
const serviceName = isPosVariant ? `POS percetakan di ${targetLocation}` : `Aplikasi percetakan di ${targetLocation}`;
const whatsappHref = `https://wa.me/6281212656699?text=${encodeURIComponent(
  `Halo POS Percetakan, saya ingin konsultasi aplikasi percetakan untuk bisnis di ${targetLocation}.`
)}`;

const localSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: `POS Percetakan untuk Percetakan di ${targetLocation}`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: pageUrl,
    description: pageDescription,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "IDR",
      availability: "https://schema.org/InStock",
    },
    areaServed: {
      "@type": schemaAreaType,
      name: targetLocation,
      address: {
        "@type": "PostalAddress",
        addressRegion: page.province,
        addressCountry: "ID",
      },
    },
    provider: {
      "@type": "Organization",
      name: "POS Percetakan",
      url: "https://pospercetakan.com",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: serviceName,
    serviceType: "Software POS dan manajemen operasional percetakan",
    provider: {
      "@type": "Organization",
      name: "POS Percetakan",
      url: "https://pospercetakan.com",
    },
    areaServed: {
      "@type": schemaAreaType,
      name: targetLocation,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: `Apakah POS Percetakan bisa digunakan oleh percetakan di ${targetLocation}?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `Bisa. POS Percetakan berbasis web sehingga bisnis percetakan di ${targetLocation} dapat mengelola order, produksi, stok, pembayaran, dan laporan dari satu dashboard.`,
        },
      },
      {
        "@type": "Question",
        name: "Apakah aplikasi ini cocok untuk digital printing dan percetakan offset?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Cocok. Sistem dapat dipakai untuk mencatat pesanan digital printing, offset, banner, undangan, merchandise, dan kebutuhan produksi percetakan lain.",
        },
      },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={localSchema}>
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-gradient-to-b from-payflo-gray/60 to-white">
    <div class="container-custom">
      <div class="max-w-4xl">
        <p class="mb-4 inline-flex rounded-full bg-payflo-purple/10 px-4 py-2 text-sm font-semibold text-payflo-purple">
          Area layanan: {targetLocation}, {page.province}
        </p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-normal text-payflo-dark">
          {heading}
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl leading-8 text-gray-600">
          Kelola order pelanggan, status produksi, stok bahan, pembayaran, invoice, dan laporan penjualan
          untuk bisnis percetakan di {targetLocation} dalam satu sistem POS yang rapi.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={whatsappHref} class="btn btn-primary text-center">Konsultasi Demo</a>
          <a href="/#main-content" class="btn btn-secondary text-center">Lihat Fitur</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="container-custom">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-normal text-payflo-dark">
            Sistem operasional untuk percetakan di {targetLocation} yang ingin lebih rapi
          </h2>
          <div class="mt-6 space-y-5 text-gray-600 leading-8">
            <p>
              Banyak percetakan di {targetLocation} menerima pesanan dari berbagai kanal: walk-in, WhatsApp,
              pelanggan korporat, sekolah, kampus, UMKM, dan reseller. Tanpa sistem yang terpusat,
              detail ukuran, bahan, finishing, deadline, pembayaran, dan status produksi mudah tercecer.
            </p>
            <p>
              POS Percetakan membantu tim kasir, admin, produksi, dan owner bekerja dari data yang sama.
              Setiap order bisa dicatat dengan detail, dipantau status produksinya, dan dirangkum menjadi
              laporan penjualan yang lebih mudah dibaca.
            </p>
          </div>
        </div>

        <div class="rounded-lg border border-gray-200 bg-payflo-gray/50 p-6">
          <h3 class="text-xl font-semibold text-payflo-dark">Cocok untuk bisnis:</h3>
          <ul class="mt-5 space-y-3">
            {page.businessTypes.map((type) => (
              <li class="flex gap-3 text-gray-700">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-payflo-purple"></span>
                <span class="capitalize">{type}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-payflo-gray">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-normal text-payflo-dark">
          Fitur utama untuk percetakan di {targetLocation}
        </h2>
        <p class="mt-4 text-gray-600 leading-8">
          Fokusnya adalah mengurangi pekerjaan manual yang sering menghambat operasional percetakan.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {[
          ["Manajemen Order", "Catat pesanan, spesifikasi cetak, deadline, DP, pelunasan, dan status pengerjaan dari satu tempat."],
          ["Monitoring Produksi", "Pantau status order mulai dari masuk, desain, cetak, finishing, siap kirim, sampai selesai."],
          ["Stok Bahan", "Kelola penggunaan bahan seperti kertas, tinta, bahan banner, dan material produksi lain."],
          ["Invoice dan Pembayaran", "Buat tagihan, catat pembayaran, dan kurangi risiko transaksi yang belum tertagih."],
          ["Laporan Penjualan", "Lihat performa penjualan, order aktif, omzet, dan data operasional untuk keputusan bisnis."],
          ["Multi Cabang", "Siap dipakai jika bisnis percetakan memiliki beberapa outlet atau tim operasional berbeda."],
        ].map(([feature, detail]) => (
          <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-semibold text-payflo-dark">{feature}</h3>
            <p class="mt-3 leading-7 text-gray-600">{detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="container-custom">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-normal text-payflo-dark">
            Area yang relevan di sekitar {targetLocation}
          </h2>
          <p class="mt-5 leading-8 text-gray-600">
            Halaman ini ditujukan untuk bisnis percetakan yang melayani pelanggan di wilayah {targetLocation}
            dan sekitarnya, termasuk area berikut.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {page.areas.map((area) => (
              <span class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700">
                {area}
              </span>
            ))}
          </div>
        </div>

        <div class="rounded-lg bg-gradient-to-br from-payflo-purple to-payflo-blue p-8 text-white">
          <h2 class="text-2xl md:text-3xl font-bold tracking-normal">Ingin demo untuk percetakan di {targetLocation}?</h2>
          <p class="mt-4 leading-7 text-white/85">
            Konsultasikan alur order, produksi, dan laporan yang kamu gunakan sekarang. Dari situ kita bisa
            lihat bagaimana POS Percetakan cocok untuk operasional bisnismu.
          </p>
          <a href={whatsappHref} class="mt-6 inline-block rounded-lg bg-white px-6 py-3 font-semibold text-payflo-purple transition hover:bg-white/90">
            Hubungi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-payflo-gray">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-bold tracking-normal text-payflo-dark">FAQ</h2>
      <div class="mt-8 space-y-5">
        <article class="rounded-lg bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-payflo-dark">Apakah POS Percetakan bisa digunakan oleh percetakan di {targetLocation}?</h3>
          <p class="mt-3 leading-7 text-gray-600">
            Bisa. Sistem berbasis web sehingga bisa digunakan oleh tim percetakan di {targetLocation} tanpa perlu server lokal khusus.
          </p>
        </article>
        <article class="rounded-lg bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-payflo-dark">Apakah cocok untuk digital printing dan offset?</h3>
          <p class="mt-3 leading-7 text-gray-600">
            Cocok untuk digital printing, offset, banner, spanduk, undangan, merchandise, dan model bisnis percetakan lain yang butuh pencatatan order dan produksi.
          </p>
        </article>
      </div>
    </div>
  </section>
</Layout>
