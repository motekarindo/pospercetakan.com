---
import Layout from '../layouts/Layout.astro';
import { localPages } from '../data/localPages';

const getPosSlug = (slug: string) => slug.replace(/^aplikasi-percetakan-di-/, 'pos-percetakan-di-');

const pagesByProvince = localPages.reduce<Record<string, typeof localPages[number][]>>((groups, page) => {
  groups[page.province] ??= [];
  groups[page.province].push(page);
  return groups;
}, {});

const provinces = Object.keys(pagesByProvince).sort((a, b) => a.localeCompare(b, 'id'));
---

<Layout
  title="Area Layanan Aplikasi Percetakan | POS Percetakan"
  description="Daftar area layanan POS Percetakan untuk kota dan kabupaten di Indonesia. Temukan halaman aplikasi percetakan sesuai lokasi bisnis Anda."
  keywords="area layanan aplikasi percetakan, aplikasi percetakan Indonesia, software percetakan kota kabupaten, POS percetakan Indonesia"
>
  <section class="pt-20 pb-16 md:pt-28 md:pb-20 bg-gradient-to-b from-payflo-gray/60 to-white">
    <div class="container-custom">
      <div class="max-w-4xl">
        <p class="mb-4 inline-flex rounded-full bg-payflo-purple/10 px-4 py-2 text-sm font-semibold text-payflo-purple">
          514 kota dan kabupaten
        </p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-normal text-payflo-dark">
          Area Layanan Aplikasi Percetakan
        </h1>
        <p class="mt-6 max-w-3xl text-lg md:text-xl leading-8 text-gray-600">
          POS Percetakan dapat digunakan oleh bisnis digital printing, percetakan offset, print shop,
          vendor merchandise, dan percetakan undangan di berbagai kota dan kabupaten Indonesia.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="container-custom">
      <div class="grid gap-8">
        {provinces.map((province) => (
          <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-2xl font-bold tracking-normal text-payflo-dark">{province}</h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {pagesByProvince[province].map((page) => (
                <div class="rounded-lg border border-gray-200 p-4">
                  <p class="font-semibold text-payflo-dark">{page.type} {page.city}</p>
                  <div class="mt-3 grid gap-2">
                    <a
                      href={`/${page.slug}/`}
                      class="text-sm font-medium text-gray-700 transition hover:text-payflo-purple focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2 rounded"
                    >
                      Aplikasi Percetakan
                    </a>
                    <a
                      href={`/${getPosSlug(page.slug)}/`}
                      class="text-sm font-medium text-gray-700 transition hover:text-payflo-purple focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2 rounded"
                    >
                      POS Percetakan
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
